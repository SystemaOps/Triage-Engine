# ── OpenRouter ─────────────────────────────────────────────────────────────────
# Required: your OpenRouter API key (openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Admin ──────────────────────────────────────────────────────────────────────
# Required to use POST /admin/rebuild-index
# Set to any strong random string, e.g.: openssl rand -hex 32
ADMIN_API_KEY=your_admin_key_here

# ── Optional overrides ─────────────────────────────────────────────────────────
# Override the LLM model (default: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free)
# LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Number of RAG results to retrieve per query (default: 4)
# RAG_TOP_K=4

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# LOG_LEVEL=INFO
