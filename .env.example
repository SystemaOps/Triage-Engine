# =============================================================================
# Medical Triage Admin Portal — Environment Configuration
# =============================================================================
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in your Firebase project credentials.
#
# DO NOT commit .env.* files to git (they are gitignored).
# Only .env.example should be committed.
# =============================================================================

# ── Firebase Configuration ──
# Required. Create a Firebase project at https://console.firebase.google.com
# then copy the Web App credentials from Project Settings → General → Your apps.

VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
