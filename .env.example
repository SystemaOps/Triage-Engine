# =============================================================================
# Medical Triage Admin Portal — Environment Configuration
# =============================================================================
# Copy this file to .env.development, .env.staging, or .env.production
# and fill in your Firebase project credentials.
#
# DO NOT commit .env.* files to git (they are gitignored).
# Only .env.example should be committed.
# =============================================================================

# ── Firebase Configuration ──
# Required. Create a Firebase project at https://console.firebase.google.com
# then copy the Web App credentials from Project Settings → General → Your apps.

VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Express Server Configuration ──
# These are read by the Express server (server/index.ts) at startup.
# Not prefixed with VITE_ — they are server-side only.

PORT=5001
NODE_ENV=development

# ── Vector Search (Pinecone + OpenAI) ──
# Required for semantic triage case search on the Express backend.
# Note: Embdeddings use OpenAI directly (no unified API equivalent).
#
# Get a Pinecone API key from https://www.pinecone.io
# Create an index with:
#   - Dimensions: 1536 (OpenAI text-embedding-3-small)
#   - Metric: cosine
#   - Pod type: serverless
#
# Get an OpenAI API key from https://platform.openai.com/api-keys

OPENAI_API_KEY="sk-your-openai-key-here"
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX="triage-cases"

# ── Unified Triage API Configuration ──
# Consolidated API endpoint for LLM + RAG triage, OCR report processing,
# visual symptom analysis, and X-ray classification.
# All these services now use a single endpoint.
# Defaults to https://medical-triage-production.up.railway.app/api/v1 if not set.

TRIAGE_API_BASE_URL="https://medical-triage-production.up.railway.app/api/v1"

# LLM_ADMIN_KEY is used for admin operations (e.g., rebuild-index)
# LLM_ADMIN_KEY="medtriage2026"

# ── STT (Speech-to-Text) Service Configuration ──
# URL for the external STT microservice for audio transcription.
# Note: STT has no equivalent in the unified triage API — kept separate.
# Defaults to https://stt-tts-service-production.up.railway.app if not set.

STT_API_BASE_URL="https://stt-tts-service-production.up.railway.app"

# ── TTS (Text-to-Speech) Service Configuration ──
# Uses OpenAI TTS API (tts-1 / tts-1-hd models).
# Note: TTS has no equivalent in the unified triage API — kept separate.
# Requires the OPENAI_API_KEY which is already set above for embeddings.
# No additional configuration needed — reuses the existing OpenAI key.

# ── API Authentication ──
# Shared secret for authenticating requests to the Express server.
# The frontend sends this as: Authorization: Bearer <ADMIN_API_KEY>
# If not set, authentication is skipped (local dev mode).

ADMIN_API_KEY="dev-local-key-change-in-production"

# ── File Ingestion Watcher ──
# The daemon (server/services/fileWatcher.ts) automatically monitors
# ./ingestion/incoming/ for patient/report files (JSON or CSV).
# Set to 1 to disable automatic startup on server boot.
# DISABLE_FILE_WATCHER=1

# ── Frontend API Configuration ──
# Used by the React SPA to talk to the Express backend.
# In development, the server runs on localhost:5001.

VITE_API_BASE_URL="http://localhost:5001"
VITE_ADMIN_API_KEY="dev-local-key-change-in-production"
